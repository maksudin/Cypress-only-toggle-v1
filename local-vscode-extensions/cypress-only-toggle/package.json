{
  "name": "cypress-only-toggle",
  "displayName": "Cypress Only Toggle",
  "description": "Adds CodeLens actions for Cypress tests.",
  "version": "0.0.1",
  "publisher": "local",
  "engines": {
    "vscode": "^1.84.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:typescript",
    "onLanguage:javascript"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "cypress.toggleOnlyAndCopyPath",
        "title": "Cypress: toggle it.only and copy path"
      },
      {
        "command": "cypress.toggleHideApiLogs",
        "title": "Cypress: toggle hide API logs"
      },
      {
        "command": "cypress.toggleOnlyAndRunHeadless",
        "title": "Cypress: toggle it.only and run spec (headless)"
      }
    ]
  }
}
